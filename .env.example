# ============================================================
# CodeMentor — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ── Judge0 ───────────────────────────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# ── OpenAI (AI hints & code review) ─────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here

# ── Frontend CORS ────────────────────────────────────────────
# Single origin or comma-separated list. Dev (Next.js): http://localhost:3000
# Production: the server's public origin, e.g. http://<server-ip>
CORS_ORIGIN=http://localhost:3000

# ── Google OAuth (inlined into frontend bundle at build) ────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Firebase (public web config — safe to be non-secret, but keep out of git
#    anyway for consistency; see backend/firebase-service-account.json separately) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Exam integrity mail (optional) ────────────────────────────
# When the server PROVES tampering during an exam, it mails the student and every admin. Any SMTP provider works: Gmail with an app
# password (smtp.gmail.com, 587), Brevo (smtp-relay.brevo.com, 587), or the college mail server. Leave SMTP_HOST empty to turn mail off:
# the evidence is still recorded and shown on the exam's integrity page.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CodeMentor <no-reply@your-college.example>
# The site address people open (used for the link in the admin mail). Defaults to the first CORS_ORIGIN.
APP_URL=
