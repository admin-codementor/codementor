# ============================================================
# CodeMentor — .gitignore
# ============================================================

# ── Legacy frontend (replaced by frontend-next/) ─────────────
frontend/

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
yarn.lock

# ── Environment Variables ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.env

# ── Firebase secrets ─────────────────────────────────────────
backend/service-account.json
backend/firebase-service-account.json

# ── Build Outputs ────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# ── React / Vite ─────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Backend ──────────────────────────────────────────────────
backend/dist/
backend/logs/
backend/*.log

# ── Judge0 / Docker ──────────────────────────────────────────
judge0/data/
judge0/postgres-data/
judge0/redis-data/

# ── Editors / IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Temporary Files ──────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak

# ── Secrets / Certificates ───────────────────────────────────
*.pem
*.key
*.crt
*.p12
# Local credential notes — this repository is public; nothing here may be committed.
docs/credentials
docs/credentials/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Local test / scratch artifacts ───────────────────────────
_smoke*.js
_cleanup.js
backend/_cleanup.js
# Local design reference (not part of the app)
Problem Solving Page Design After claude/

# ── Local Claude Code skills (personal to this machine, not shared) ─────────
# Personal skills stay out of the repo, but the vendored third-party UI guides
# below are shared project standards — they must survive a fresh clone so every
# machine and tool builds to the same rules. Licences and attribution are in
# .claude/skills/THIRD_PARTY_NOTICES.md.
.claude/skills/*
!.claude/skills/THIRD_PARTY_NOTICES.md
!.claude/skills/material-ui-styling/
!.claude/skills/material-ui-theming/
!.claude/skills/material-ui-nextjs/
!.claude/skills/frontend-design/
# One-off local admin-account creation script — writes real credentials to
# the console when run; not something to ship in the repo.
backend/scripts/create-admin-account.js

# ── Internal planning docs (kept out of a public repo) ───────
# The scale-readiness programme documents unfixed security findings, live
# infrastructure details, and internal cost/negotiation notes. Keep these out
# of git while the repository is public. If the repo is made private, consider
# tracking them again — Chapters 16–18 are the runbook and incident playbooks,
# and they are only useful if the whole team can reach them.
docs/scale-readiness/
# Compiled export of the same programme — excluding the source folder achieves
# nothing if the assembled document is committed alongside it.
docs/CodeMentor-Scale-Readiness-Programme.docx
docs.zip
