        {
          "id": "scp-9",
          "type": "topic",
          "group": "aptitude",
          "title": "Aptitude and logical reasoning",
          "why": "The round most people lose, because they practise code and assume aptitude will take care of itself. It will not: it is timed arithmetic under pressure.",
          "mcq": [
            "aptitude",
            "logical",
            "verbal"
          ],
          "subtopics": [
            "Quantitative Aptitude",
            "Logical Reasoning",
            "Verbal Ability",
            "Timed Practice"
          ]
        },
        {
          "id": "scp-10",
          "type": "topic",
          "group": "interview-prep",
          "title": "Company-pattern practice",
          "why": "Each recruiter has habits. Sit the company sets closest to your drive once you can already solve the topics above.",
          "practice": {
            "modules": [
              "tcs",
              "infosys",
              "wipro",
              "accenture",
              "cognizant",
              "capgemini"
