    {
      "id": "service-company-placement",
      "role": "Service-Company Placement",
      "tagline": "TCS, Infosys, Wipro, Accenture, Cognizant, Capgemini",
      "summary": "The shortest honest path to clearing a mass-recruiter drive. These companies test breadth, not depth: clean basics, steady coding, aptitude, and the confidence to explain what you wrote. Work through this in order and you will have seen every shape of question they ask.",
      "forWho": "Pre-final and final year students sitting for campus drives.",
      "groups": [
        {
          "id": "foundations",
          "label": "Foundations"
        },
        {
          "id": "core-dsa",
          "label": "Core DSA"
        },
        {
          "id": "aptitude",
          "label": "Aptitude"
        },
        {
          "id": "interview-prep",
          "label": "Interview Prep"
        }
      ],
      "nodes": [
        {
          "id": "scp-1",
          "type": "topic",
          "group": "foundations",
          "title": "Write and run programs without hesitating",
          "why": "Every drive starts with a timed online round. Fumbling over input parsing or a for-loop costs you the questions you could have solved.",
          "practice": {
            "modules": [
              "basics"
            ],
            "tags": [
              "programming basics"
            ],
            "count": 12
          },
          "subtopics": [
            "Variables & Loops",
            "Functions",
            "Input Parsing",
            "Conditionals"
          ]
        },
        {
          "id": "scp-2",
          "type": "topic",
          "group": "core-dsa",
          "title": "Arrays",
          "why": "More campus coding questions are array questions than anything else: traversal, searching, rotation, sub-arrays.",
          "practice": {
            "modules": [
              "arrays"
            ],
            "tags": [
              "arrays",
              "array"
            ],
            "count": 12
          },
          "subtopics": [
            "Traversal",
            "Searching",
            "Rotation",
            "Sub-arrays"
          ]
        },
        {
          "id": "scp-3",
          "type": "topic",
          "group": "core-dsa",
          "title": "Strings",
          "why": "Palindromes, anagrams, reversal, counting characters. Cheap marks once you stop fearing index arithmetic.",
          "practice": {
            "modules": [
              "strings"
            ],
            "tags": [
              "strings"
            ],
            "count": 12
          },
          "subtopics": [
            "Palindromes",
            "Anagrams",
            "Reversal",
            "Character Counting"
          ]
        },
        {
          "id": "scp-4",
          "type": "topic",
          "group": "core-dsa",
          "title": "Searching and sorting",
          "why": "Binary search turns a brute-force timeout into a pass. Knowing which sort to reach for is routinely asked aloud in interviews.",
          "practice": {
            "modules": [
              "searching",
              "sorting"
            ],
            "tags": [
              "binary search",
              "sorting"
            ],
            "count": 6
          },
          "subtopics": [
            "Binary Search",
            "Bubble/Selection Sort",
            "Merge Sort",
            "Quick Sort"
          ]
        },
        {
          "id": "scp-5",
          "type": "topic",
          "group": "core-dsa",
          "title": "Hashing",
          "why": "The single highest-leverage idea in this list: it collapses most nested-loop solutions into one pass.",
          "practice": {
            "modules": [
              "hashing"
            ],
            "tags": [
              "hashing"
            ],
            "count": 4
          },
          "subtopics": [
            "HashMap Lookups",
            "Frequency Counting",
            "Collision Handling",
            "Set Operations"
          ]
        },
        {
          "id": "scp-6",
          "type": "topic",
          "group": "core-dsa",
          "title": "Two pointers and sliding window",
          "why": "The two patterns that come up whenever a question says subarray, pair, or without repeating characters.",
          "practice": {
            "modules": [
              "two pointers",
              "sliding window"
            ],
            "tags": [
              "two pointers",
              "sliding window"
            ],
            "count": 6
          },
          "subtopics": [
            "Two Pointers",
            "Fixed Window",
            "Variable Window",
            "Subarray Sum"
          ]
        },
        {
          "id": "scp-7",
          "type": "topic",
          "group": "core-dsa",
          "title": "Stacks, queues and linked lists",
          "why": "Rarely the hard question, often the viva question. You are expected to be able to draw one and code one.",
          "practice": {
            "modules": [
              "stacks",
              "queues",
              "linked list"
            ],
            "tags": [
              "stack",
              "linked list"
            ],
            "count": 5
          },
          "subtopics": [
            "Stack",
            "Queue",
            "Singly Linked List",
            "Balanced Parentheses"
          ]
        },
        {
          "id": "scp-8",
          "type": "topic",
          "group": "core-dsa",
          "title": "Recursion and introductory DP",
          "why": "Fibonacci, staircase, coin change. Service companies stop about here, so a working memoised solution is enough.",
          "practice": {
            "modules": [
              "dynamic programming"
