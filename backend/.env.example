# ── CodeMentor backend environment (copy to .env and fill in) ──────────────────
NODE_ENV=development
PORT=3001

# Allowed frontend origin(s), comma-separated.
CORS_ORIGIN=http://localhost:3000

# Upstash Redis (analytics cache + shared rate-limit counters) — REST-based,
# works identically locally and on the deployed backend. Create a free database
# at https://console.upstash.com and copy its REST URL/token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth secrets — generate long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_long_random
JWT_REFRESH_SECRET=change_me_another_long_random

# Self-hosted Judge0 base URL. This differs per environment — set it deliberately:
#
#   local dev (Docker on your laptop) : http://localhost:2358
#   docker compose (this repo)        : http://judge0_server:2358   ← internal DNS
#   deployed (Google Cloud VM)        : http://<VM_EXTERNAL_IP>:2358
#
# NOTE: a stopped GCP VM loses its external IP unless the address is reserved as
# static — when the VM is resumed, re-check the IP before assuming the old one
# still works. A dead JUDGE0_URL means no code executes at all: submissions,
# contests and AI test-case generation all fail together.
#
# The actual host is deliberately NOT recorded here: this repository is public,
# and Judge0 executes untrusted code, so publishing its address invites abuse.
# Keep the real value in the deployed .env only.
JUDGE0_URL=http://localhost:2358
# Optional: if Judge0 has AUTHN_TOKEN set in judge0.conf, mirror it here
# JUDGE0_AUTH_TOKEN=

# AI tutor — Google AI Studio key (starts with AIza... or AQ...)
# Get one at https://aistudio.google.com/apikey, then verify it works with:
#   node src/scripts/checkAiKey.js
GEMINI_API_KEY=

# Model id. Google retires models and blocks retired ids for newly-created keys,
# so prefer a floating alias over a pinned version — a pinned `gemini-2.5-flash`
# is what silently took the AI features down. Leave blank to use the default
# (gemini-flash-latest). `gemini-flash-lite-latest` is ~3x faster and cheaper if
# tutor volume becomes the concern.
# GEMINI_MODEL=gemini-flash-latest

# Faculty account provisioning — comma-separated email domains whose users are
# created as faculty on first sign-in. Matched against the Firebase-VERIFIED
# email only. Leave blank to disable domain-based promotion entirely, in which
# case faculty must be pre-created by an admin (write the profile document into
# the `faculty` collection with their email; it links on first sign-in).
#
# Self-registration NEVER grants faculty — the client-supplied `role` field is
# ignored. Faculty permissions include reading hidden test cases, so this must
# stay locked down.
#   e.g. FACULTY_EMAIL_DOMAINS=staff.college.edu,faculty.college.edu
FACULTY_EMAIL_DOMAINS=

# JPlag (plagiarism) — set if the JAR isn't at the default backend/jplag/jplag.jar
# JPLAG_JAR_PATH=/app/jplag/jplag.jar

# Postgres — only used by the seed scripts (src/scripts/seed.js,
# seedCourses.js), never by the running API. Leave blank unless seeding.
# DATABASE_URL=postgresql://judge0:judge0_secret@localhost:5432/judge0

# Firebase Auth — two ways to supply the Admin SDK credential:
#   1. Local dev: place the key file at backend/service-account.json (gitignored).
#   2. Deployed:  set FIREBASE_SERVICE_ACCOUNT below to the file's contents,
#      either raw JSON or base64-encoded. Takes precedence over the file.
# Get it from Firebase Console → Project settings → Service accounts →
# Generate new private key. This grants full admin access and bypasses all
# Firestore rules — never commit it, never paste its contents anywhere.
FIREBASE_SERVICE_ACCOUNT=
