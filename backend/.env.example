# ── CodeMentor backend environment (copy to .env and fill in) ──────────────────
NODE_ENV=development
PORT=3001

# Allowed frontend origin(s), comma-separated.
CORS_ORIGIN=http://localhost:3000

# Upstash Redis (analytics cache + shared rate-limit counters) — REST-based,
# works identically locally and on Vercel. Create a free database at
# https://console.upstash.com and copy its REST URL/token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth secrets — generate long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_long_random
JWT_REFRESH_SECRET=change_me_another_long_random

# Self-hosted Judge0 base URL (internal Docker DNS in compose, or its private IP/host)
JUDGE0_URL=http://localhost:2358
# Optional: if Judge0 has AUTHN_TOKEN set in judge0.conf, mirror it here
# JUDGE0_AUTH_TOKEN=

# AI tutor — Google AI Studio key (starts with AIza... or AQ...)
GEMINI_API_KEY=

# JPlag (plagiarism) — set if the JAR isn't at the default backend/jplag/jplag.jar
# JPLAG_JAR_PATH=/app/jplag/jplag.jar

# Firebase Auth — no env var needed here. Instead, place your Firebase
# service account key at backend/firebase-service-account.json
# (Firebase Console → Project settings → Service accounts → Generate new
# private key). That file is gitignored and must be copied to each machine
# separately — never commit it, never paste its contents anywhere.
