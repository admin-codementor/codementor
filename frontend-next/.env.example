# Frontend environment (Next.js reads NEXT_PUBLIC_* at build/start time — restart `npm run dev` after edits)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend origin. src/lib/api.ts uses baseURL "/" so every API call is
# same-origin and goes through the /api/* rewrite in next.config.ts — this is
# that rewrite's target. NOTE: rewrites are serialized at BUILD time, so
# changing this needs a rebuild/redeploy, not just a restart. In production set
# this — or the server-only API_PROXY_TARGET — to the deployed backend URL,
# otherwise /api/* proxies to localhost and every request fails.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Firebase (public web config — safe to expose in the browser bundle) ─────
# From Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
